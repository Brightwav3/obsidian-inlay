# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Exclude sourcemaps
*.map

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Showcase vault: keep content and appearance, not per-machine state
showcase-vault/.obsidian/*
!showcase-vault/.obsidian/appearance.json
!showcase-vault/.obsidian/app.json

# Machine-specific vault list for npm run sync
vaults.local.txt

# Ad-hoc screenshots dropped into the showcase vault
showcase-vault/*.png
